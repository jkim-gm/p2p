<Window x:Class="P2PSampleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 대용량 파일 P2P 전송 샘플 프로그램 (.NET Framework 4.6.1 - 채팅 분리 &amp; P2P 헤더 프로토콜)"
        Height="830" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 설정 및 시뮬레이션 제어 바 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#D0D7DE" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="서버 IP:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtServerIp" Text="127.0.0.1" Width="100" VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,10,0" ToolTip="127.0.0.1 사용 시 Loopback으로 바인딩되어 Windows 방화벽 팝업이 뜨지 않습니다."/>

                <TextBlock Text="채팅 포트(앱):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtChatPort" Text="9001" Width="52" VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,10,0"/>

                <TextBlock Text="P2P 포트(DLL):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtP2PPort" Text="9002" Width="52" VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,14,0"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0,12,0"/>

                <TextBlock Text="전송 속도 제한(KB/s, 0=무제한):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtSpeedLimit" Text="2048" Width="60" VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,6,0"/>
                <Button Content="속도 적용" Click="BtnApplyOptions_Click" Padding="8,3" Margin="0,0,12,0"/>

                <TextBlock Text="최대 동시 수신자 수:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtMaxReceivers" Text="3" Width="38" VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,6,0"/>
                <Button Content="동시수신 적용" Click="BtnApplyOptions_Click" Padding="8,3" Margin="0,0,14,0"/>

                <Button Content="전체 클라이언트(B~F) 일괄 채팅 시작" Click="BtnConnectAllClients_Click" Background="#1F883D" Foreground="White" FontWeight="Bold" Padding="10,4" Margin="0,0,8,0"/>
                <Button Content="테스트용 대용량 더미 파일 생성 및 전송" Click="BtnSendSampleFiles_Click" Background="#0969DA" Foreground="White" FontWeight="Bold" Padding="10,4"/>
            </WrapPanel>
        </Border>

        <!-- 메인 컨텐츠 영역 (좌측: 채팅 목록 및 채팅창 / 우측: 파일 송신 및 수신 목록) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- [좌측] 샘플 프로그램 채팅 노드 목록 (채팅은 최초 파일명/크기 알림만 수행) -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="10" BorderBrush="#D0D7DE" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="1. 채팅 목록 (A:송신서버, B~F:수신클라이언트)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Button Content="+ 수신자 추가" Click="BtnAddClientNode_Click" HorizontalAlignment="Right" Padding="6,2" FontSize="11"/>
                    </DockPanel>

                    <ListBox x:Name="LstPeers" Grid.Row="1" SelectionChanged="LstPeers_SelectionChanged" BorderBrush="#D0D7DE" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" BorderBrush="#EAECEF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="{Binding ConnectionStateText}" FontSize="11" Foreground="#57606A"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ConnectButtonText}" Tag="{Binding}" Click="BtnToggleNodeConnection_Click" Padding="8,3" Margin="6,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Row="2" Margin="0,10,0,6">
                        <TextBlock x:Name="TxtActiveChatHeader" Text="채팅 로그 [A: 송신자]" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Button x:Name="BtnSelectAndSendFiles" Content="파일 선택 및 채팅 알림 (A 전용)" Click="BtnSelectAndSendFiles_Click" HorizontalAlignment="Right" Background="#0969DA" Foreground="White" Padding="8,3"/>
                    </DockPanel>

                    <ListBox x:Name="LstChatMessages" Grid.Row="3" BorderBrush="#D0D7DE" Background="#FAFBFC" FontFamily="Consolas, Malgun Gothic" FontSize="12"/>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtChatInput" Grid.Column="0" Padding="6,5" KeyDown="TxtChatInput_KeyDown" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="메시지 전송" Click="BtnSendChat_Click" Padding="12,5" Margin="6,0,0,0" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- [우측] P2P 라이브러리(P2P 포트)가 처리하는 파일 송신 목록 & 파일 수신 목록 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1.15*"/>
                </Grid.RowDefinitions>

                <!-- [우측 상단] 파일 송신 목록 (수신자가 요청한 패킷 번호 기반으로 진행률 표시 및 일시정지/재개/취소 제어) -->
                <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="10" BorderBrush="#D0D7DE" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="2. 파일 송신 목록 (P2P 포트 - 수신자 요청 패킷번호 기반 진행상태 및 제어)" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="선택 일시정지" Click="BtnSenderPauseSelected_Click" Padding="8,3" Margin="0,0,6,0"/>
                                <Button Content="선택 재개" Click="BtnSenderResumeSelected_Click" Padding="8,3" Margin="0,0,6,0"/>
                                <Button Content="선택 전송 취소" Click="BtnSenderCancelSelected_Click" Padding="8,3" Margin="0,0,6,0"/>
                                <Button Content="전체 송신 취소" Click="BtnSenderCancelAll_Click" Padding="8,3" Foreground="#CF222E"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="GridSenderTransfers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  BorderBrush="#D0D7DE" RowBackground="White" AlternatingRowBackground="#F6F8FA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="수신자" Binding="{Binding PeerName}" Width="105"/>
                                <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="170"/>
                                <DataGridTextColumn Header="크기" Binding="{Binding FileSizeDisplay}" Width="80"/>
                                <DataGridTemplateColumn Header="진행률 (요청 패킷번호 기준)" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="18" Foreground="#2DA44E"/>
                                                <TextBlock Text="{Binding ProgressDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="상태" Binding="{Binding StatusKor}" Width="110"/>
                                <DataGridTextColumn Header="상세 메시지" Binding="{Binding StatusMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- [우측 하단] 파일 수신 목록 (수신자 B~F별 상태, 수락/일시정지/이어받기/취소 및 다운로드 폴더 설정) -->
                <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="10" BorderBrush="#D0D7DE" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="3. 파일 수신 목록 - 조회할 수신자:" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbReceiverFilter" Width="170" SelectionChanged="CmbReceiverFilter_SelectionChanged" DisplayMemberPath="DisplayName"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="현재 수신자 전체 수락/이어받기" Click="BtnReceiverAcceptAll_Click" Background="#1F883D" Foreground="White" FontWeight="Bold" Padding="8,3" Margin="0,0,6,0"/>
                                <Button Content="모든 수신자(B~F) 동시 수신수락 (동시전송/대기열 테스트)" Click="BtnAllClientsAcceptSimultaneously_Click" Background="#8250DF" Foreground="White" FontWeight="Bold" Padding="8,3" Margin="0,0,6,0"/>
                                <Button Content="파일 존재 여부 새로고침" Click="BtnCheckMissingFiles_Click" Padding="8,3"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- 수신 목록 옵션: 다운로드 폴더 위치 설정 -->
                        <Border Grid.Row="1" Background="#F6F8FA" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" BorderBrush="#D0D7DE" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="다운로드 폴더 위치:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtDownloadFolder" Grid.Column="1" VerticalContentAlignment="Center" Padding="4,2" TextChanged="TxtDownloadFolder_TextChanged"/>
                                <Button Grid.Column="2" Content="폴더 찾아보기..." Click="BtnBrowseDownloadFolder_Click" Padding="8,3" Margin="6,0,0,0"/>
                                <Button Grid.Column="3" Content="폴더 열기" Click="BtnOpenDownloadFolder_Click" Padding="8,3" Margin="6,0,0,0"/>
                                <Button Grid.Column="4" Content="선택된 완료파일 삭제(파일없음 테스트)" Click="BtnDeleteCompletedFileTest_Click" Padding="8,3" Margin="6,0,0,0" Foreground="#CF222E"/>
                            </Grid>
                        </Border>

                        <!-- 수신 파일 목록 그리드 -->
                        <DataGrid x:Name="GridReceiverTransfers" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  BorderBrush="#D0D7DE" RowBackground="White" AlternatingRowBackground="#F6F8FA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="수신자" Binding="{Binding OwnerPeerName}" Width="80"/>
                                <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="145"/>
                                <DataGridTextColumn Header="크기" Binding="{Binding FileSizeDisplay}" Width="70"/>
                                <DataGridTextColumn Header="유효시간(30분)" Binding="{Binding RemainingValidTimeText}" Width="95"/>
                                <DataGridTemplateColumn Header="진행률 (수신 패킷번호 기준)" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="18" Foreground="#0969DA"/>
                                                <TextBlock Text="{Binding ProgressDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="상태" Binding="{Binding StatusKor}" Width="105"/>
                                <DataGridTemplateColumn Header="P2P 제어 동작" Width="175">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="수락/이어받기" Tag="{Binding}" Click="BtnAcceptSingleItem_Click" IsEnabled="{Binding CanAccept}" Padding="4,1" FontSize="11" Margin="0,0,3,0"/>
                                                <Button Content="일시정지" Tag="{Binding}" Click="BtnPauseSingleItem_Click" IsEnabled="{Binding CanPause}" Padding="4,1" FontSize="11" Margin="0,0,3,0"/>
                                                <Button Content="취소" Tag="{Binding}" Click="BtnCancelSingleItem_Click" IsEnabled="{Binding CanCancel}" Padding="4,1" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="상세 메시지" Binding="{Binding StatusMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

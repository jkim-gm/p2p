<Window x:Class="P2PSampleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P2PTransferLib 심플 로그 테스트 프로그램 (.NET Framework 4.6.1)"
        Height="740" Width="1220"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- [좌측] 송신자 (서버) 영역 -->
        <GroupBox Grid.Column="0" Header="1. 송신자 (P2P 서버 - P2PSenderNode.Instance)" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 서버 포트 오픈 및 옵션 -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="바인딩 IP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtServerBindIp" Text="127.0.0.1" Width="90" Padding="3,2" Margin="0,0,8,0"/>

                    <TextBlock Text="포트:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtServerPort" Text="9002" Width="50" Padding="3,2" Margin="0,0,8,0"/>

                    <Button x:Name="BtnStartServer" Content="서버 시작(포트 오픈)" Click="BtnStartServer_Click" Padding="8,3" Margin="0,0,4,0" FontWeight="Bold"/>
                    <Button x:Name="BtnStopServer" Content="서버 중지" Click="BtnStopServer_Click" Padding="8,3" Margin="0,0,10,0"/>
                </WrapPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="동시전송 제한 수:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtMaxReceivers" Text="3" Width="35" Padding="3,2" Margin="0,0,8,0"/>

                    <TextBlock Text="속도제한(KB/s, 0=무제한):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSpeedLimit" Text="512" Width="55" Padding="3,2" Margin="0,0,6,0"/>

                    <Button Content="옵션 적용" Click="BtnApplyServerOptions_Click" Padding="8,2"/>
                </WrapPanel>

                <!-- 파일, 채널ID(chID), 파일ID(msgID) 등록 -->
                <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="#F9F9F9">
                    <StackPanel>
                        <TextBlock Text="[파일 + 채널ID(chID) + 파일ID(msgID) 등록]" FontWeight="Bold" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="채널ID (chID):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtRegisterChId" Text="CH_ROOM1" Width="80" Padding="3,2" Margin="0,0,8,0"/>

                            <TextBlock Text="파일ID (msgID):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtRegisterMsgId" Text="MSG_1001" Width="80" Padding="3,2" Margin="0,0,8,0"/>

                            <TextBlock Text="파일경로:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtRegisterFilePath" Width="150" Padding="3,2" Margin="0,0,4,0"/>
                            <Button Content="찾기..." Click="BtnBrowseFile_Click" Padding="6,2"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="파일 + chID/msgID 등록" Click="BtnRegisterFile_Click" Padding="10,4" Margin="0,0,6,0" FontWeight="Bold"/>
                            <Button Content="테스트용 더미 파일(MSG_1001, MSG_1002) 자동생성 및 등록" Click="BtnCreateDummyAndRegister_Click" Padding="8,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 송신 목록 조회 및 제어 버튼 -->
                <WrapPanel Grid.Row="3" Margin="0,0,0,8" VerticalAlignment="Center">
                    <Button Content="송신파일 목록 조회 (상태 / 유효시간 확인)" Click="BtnShowSenderList_Click" Padding="8,3" Margin="0,0,6,0" FontWeight="Bold"/>
                    <Button Content="현재 chID+msgID 송신취소" Click="BtnCancelSenderTransfer_Click" Padding="8,3" Margin="0,0,6,0"/>
                    <Button Content="로그 지우기" Click="BtnClearSenderLog_Click" Padding="6,3"/>
                </WrapPanel>

                <!-- 송신자 로그 출력창 -->
                <TextBox x:Name="TxtSenderLog" Grid.Row="4" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Malgun Gothic" FontSize="12" Background="#1E1E1E" Foreground="#D4D4D4" Padding="6" TextWrapping="NoWrap"/>
            </Grid>
        </GroupBox>

        <!-- [우측] 수신자 (클라이언트) 영역 -->
        <GroupBox Grid.Column="2" Header="2. 수신자 (P2P 클라이언트 - P2PReceiverNode.Instance)" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 서버 주소, 사번(peerID), 이름(peerName), 채널ID(chID), 파일ID(msgID) 입력 및 수신 버튼 -->
                <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="#F9F9F9">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="서버 IP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtTargetServerIp" Text="127.0.0.1" Width="90" Padding="3,2" Margin="0,0,10,0"/>

                            <TextBlock Text="서버 포트:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtTargetServerPort" Text="9002" Width="50" Padding="3,2" Margin="0,0,10,0"/>

                            <TextBlock Text="저장 폴더:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtDownloadFolder" Width="195" Padding="3,2"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="사번(peerID):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtPeerId" Text="EMP_2001" Width="75" Padding="3,2" Margin="0,0,8,0"/>

                            <TextBlock Text="이름(peerName):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtPeerName" Text="홍길동" Width="60" Padding="3,2" Margin="0,0,8,0"/>

                            <TextBlock Text="채널ID(chID):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtRequestChId" Text="CH_ROOM1" Width="80" Padding="3,2" Margin="0,0,8,0"/>

                            <TextBlock Text="파일ID(msgID):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtRequestMsgId" Text="MSG_1001" Width="80" Padding="3,2"/>
                        </WrapPanel>

                        <WrapPanel>
                            <Button Content="수신 시작 (추가 다운로드 가능)" Click="BtnStartReceive_Click" Padding="12,5" Margin="0,0,6,0" FontWeight="Bold"/>
                            <Button Content="5명 동시 수신 요청 테스트(동시제한/대기열 확인)" Click="BtnTestMultiConcurrentReceive_Click" Padding="8,5"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 수신 목록 조회 및 일시정지 / 재개 / 취소 제어 버튼 -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
                    <Button Content="수신목록 조회 (상태 / 유효시간 확인)" Click="BtnShowReceiverList_Click" Padding="8,3" Margin="0,0,6,0" FontWeight="Bold"/>
                    <Button Content="일시정지" Click="BtnPauseReceive_Click" Padding="8,3" Margin="0,0,4,0"/>
                    <Button Content="재개(Resume)" Click="BtnResumeReceive_Click" Padding="8,3" Margin="0,0,4,0"/>
                    <Button Content="수신취소" Click="BtnCancelReceive_Click" Padding="8,3" Margin="0,0,6,0"/>
                    <Button Content="로그 지우기" Click="BtnClearReceiverLog_Click" Padding="6,3"/>
                </WrapPanel>

                <!-- 수신자 로그 출력창 -->
                <TextBox x:Name="TxtReceiverLog" Grid.Row="2" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Malgun Gothic" FontSize="12" Background="#1E1E1E" Foreground="#A6E22E" Padding="6" TextWrapping="NoWrap"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
